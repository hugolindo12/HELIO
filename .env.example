# Copie para heilo/.env e ajuste. O .env nunca vai para o GitHub.

# Motor da conversa: auto | seed | teacher | off   (aliases antigos: mini, lora)
HEILO_BRAIN_MODE=auto

# HEILO Teacher (modelo externo temporário). false = só o HEILO Seed.
HEILO_TEACHER_ENABLED=true
# O Teacher só responde no chat se isto for true (por padrão ele é só professor).
HEILO_TEACHER_IN_CHAT=false

# Grava as conversas na memória local (memory/sessions/). Não treina nada.
HEILO_MEMORY_LOG=true

# Offline: o Teacher usa só o cache local do Hugging Face.
HEILO_OFFLINE=0

# Segredos ficam aqui, nunca no código:
# OPENAI_API_KEY=
# GITHUB_TOKEN=
